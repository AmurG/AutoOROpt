+def safe_eval_arith(expr):
+    if not re.fullmatch(r'[0-9eE\+\-\*/\.\(\)\s]+', expr):
+        return None
+    try:
+        return float(eval(expr, {"__builtins__": {}}, {}))
+    except Exception:
+        return None
+
