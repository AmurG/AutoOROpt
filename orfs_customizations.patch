diff --git a/flow/run.sh b/flow/run.sh
new file mode 100755
index 000000000..c4dcb377d
--- /dev/null
+++ b/flow/run.sh
@@ -0,0 +1,361 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# -----------------------------------------------------------------------------
+# Helpers
+# -----------------------------------------------------------------------------
+usage() {
+  cat <<'EOF'
+Usage: ./run.sh [options] [-- make_args...]
+
+Required options:
+  -p, --pdk <name>        Target PDK (e.g. sky130hd, nangate45)
+  -d, --design <name>     Design inside designs/<pdk>/ (e.g. aes)
+  -o, --openroad <value>  OpenROAD build selector: ref, ecp, rwl, pwr
+                          Overrides: OPENROAD_ECP, OPENROAD_RWL, OPENROAD_PWR
+Optional:
+  -c, --config <name|path> Optional: for-rwl | for-ecp | for-pwr | <config file path> (default: config.mk)
+  -clock_noise <ps>       Add clock noise (in picoseconds) to create_clock -period values
+  -s, --scripts-dir <dir> Override scripts directory (sets SCRIPTS_DIR for make; otherwise auto-picks scripts_ref/scripts_ecp/scripts_rwl).
+
+Misc:
+  -h, --help              Show this help
+  Extra args (or args after `--`) are forwarded to make (e.g. clean_floorplan, -j8).
+
+EOF
+}
+
+log()   { echo "[INFO] $*" >&2; }
+die()   { echo "[ERROR] $*" >&2; exit 1; }
+lower() { echo "$1" | tr '[:upper:]' '[:lower:]'; }
+require_arg() {
+  local flag="$1"
+  local value="${2:-}"
+  [[ -n "$value" ]] || die "Missing argument for $flag"
+}
+
+# -----------------------------------------------------------------------------
+# Argument parsing
+# -----------------------------------------------------------------------------
+PLATFORM=""
+DESIGN=""
+OR_INPUT=""
+CONFIG_INPUT=""
+SCRIPTS_DIR_OVERRIDE=""
+CLOCK_NOISE_PS=""
+MAKE_ARGS=()
+CONFIG_SYNTH=""
+CONFIG_FLOORPLAN=""
+CONFIG_PLACE=""
+CONFIG_CTS=""
+CONFIG_ROUTE=""
+CONFIG_FINISH=""
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    -p|--pdk|--platform) require_arg "$1" "${2:-}"; PLATFORM="$2"; shift 2 ;;
+    -d|--design)   require_arg "$1" "${2:-}"; DESIGN="$2"; shift 2 ;;
+    -o|--openroad) require_arg "$1" "${2:-}"; OR_INPUT="$(lower "$2")"; shift 2 ;;
+    -c|--config)   require_arg "$1" "${2:-}"; CONFIG_INPUT="$2"; shift 2 ;;
+    --config-synth)     require_arg "$1" "${2:-}"; CONFIG_SYNTH="$2"; shift 2 ;;
+    --config-floorplan) require_arg "$1" "${2:-}"; CONFIG_FLOORPLAN="$2"; shift 2 ;;
+    --config-place)     require_arg "$1" "${2:-}"; CONFIG_PLACE="$2"; shift 2 ;;
+    --config-cts)       require_arg "$1" "${2:-}"; CONFIG_CTS="$2"; shift 2 ;;
+    --config-route)     require_arg "$1" "${2:-}"; CONFIG_ROUTE="$2"; shift 2 ;;
+    --config-finish)    require_arg "$1" "${2:-}"; CONFIG_FINISH="$2"; shift 2 ;;
+    -clock_noise)  require_arg "$1" "${2:-}"; CLOCK_NOISE_PS="$2"; shift 2 ;;
+    -s|--scripts-dir) require_arg "$1" "${2:-}"; SCRIPTS_DIR_OVERRIDE="$2"; shift 2 ;;
+    -h|--help)     usage; exit 0 ;;
+    --)            shift; MAKE_ARGS+=("$@"); break ;;
+    *)             MAKE_ARGS+=("$1"); shift ;;
+  esac
+done
+
+if [[ -z "$PLATFORM" || -z "$DESIGN" || -z "$OR_INPUT" ]]; then
+  usage
+  die "All of -p/-d/-o must be provided."
+fi
+
+# -----------------------------------------------------------------------------
+# Static paths and environment
+# -----------------------------------------------------------------------------
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
+
+export XDG_RUNTIME_DIR="/tmp/${USER}-runtime"
+mkdir -p "$XDG_RUNTIME_DIR"
+chmod 700 "$XDG_RUNTIME_DIR"
+
+DESIGN_DIR="$SCRIPT_DIR/designs/$PLATFORM/$DESIGN"
+[[ -d "$DESIGN_DIR" ]] || die "Design directory '$DESIGN_DIR' does not exist."
+
+# -----------------------------------------------------------------------------
+# Determine config selection
+# -----------------------------------------------------------------------------
+FLOW_MODE=""
+CONFIG_OVERRIDE=""
+if [[ -z "$CONFIG_INPUT" ]]; then
+  FLOW_MODE="default"
+else
+  case "$(lower "$CONFIG_INPUT")" in
+    for-rwl|for-ecp|for-pwr) FLOW_MODE="$(lower "$CONFIG_INPUT")" ;;
+    *)
+      if [[ -f "$CONFIG_INPUT" ]]; then
+        CONFIG_OVERRIDE="$CONFIG_INPUT"
+        FLOW_MODE="custom"
+      else
+        die "Unsupported config '$CONFIG_INPUT'. Use for-rwl, for-ecp, for-pwr, or a config file path."
+      fi
+      ;;
+  esac
+fi
+
+CONFIG_BASE="$DESIGN_DIR/config.mk"
+[[ -f "$CONFIG_BASE" ]] || die "Base config '$CONFIG_BASE' not found."
+
+SELECTED_CONFIG=""
+if [[ -n "$CONFIG_OVERRIDE" ]]; then
+  [[ -f "$CONFIG_OVERRIDE" ]] || die "Config override '$CONFIG_OVERRIDE' not found."
+  SELECTED_CONFIG="$CONFIG_OVERRIDE"
+else
+  case "$FLOW_MODE" in
+    default)
+      SELECTED_CONFIG="$CONFIG_BASE"
+      ;;
+    for-pwr)
+      SELECTED_CONFIG="$DESIGN_DIR/config_for_pwr.mk"
+      [[ -f "$SELECTED_CONFIG" ]] || die "Power config '$SELECTED_CONFIG' not found."
+      ;;
+    for-ecp)
+      if [[ -f "$DESIGN_DIR/config_for_ecp.mk" ]]; then
+        SELECTED_CONFIG="$DESIGN_DIR/config_for_ecp.mk"
+      else
+        SELECTED_CONFIG="$DESIGN_DIR/config.mk"
+      fi
+      ;;
+    for-rwl)
+      if [[ -f "$DESIGN_DIR/config_for_rwl.mk" ]]; then
+        SELECTED_CONFIG="$DESIGN_DIR/config_for_rwl.mk"
+      else
+        SELECTED_CONFIG="$DESIGN_DIR/config.mk"
+      fi
+      ;;
+    custom)
+      SELECTED_CONFIG="$DESIGN_DIR/config.mk"
+      ;;
+  esac
+  [[ -f "$SELECTED_CONFIG" ]] || die "No matching config file found for mode=$FLOW_MODE."
+fi
+
+if [[ -n "$SCRIPTS_DIR_OVERRIDE" ]]; then
+  [[ -d "$SCRIPTS_DIR_OVERRIDE" ]] || die "Scripts dir override '$SCRIPTS_DIR_OVERRIDE' not found."
+fi
+if [[ -n "$CLOCK_NOISE_PS" && ! "$CLOCK_NOISE_PS" =~ ^-?[0-9]+([.][0-9]+)?$ ]]; then
+  die "Invalid -clock_noise '$CLOCK_NOISE_PS'. Provide a numeric value in ps."
+fi
+
+# -----------------------------------------------------------------------------
+# Resolve scripts directory (auto per OpenROAD selector unless overridden)
+# -----------------------------------------------------------------------------
+SCRIPTS_DIR_SELECTED="$SCRIPTS_DIR_OVERRIDE"
+if [[ -z "$SCRIPTS_DIR_SELECTED" ]]; then
+  declare -A SCRIPT_DIRS=(
+    [ref]="$SCRIPT_DIR/scripts_ref"
+    [ecp]="$SCRIPT_DIR/scripts_ecp"
+    [rwl]="$SCRIPT_DIR/scripts_rwl"
+    [pwr]="$SCRIPT_DIR/scripts_pwr"
+  )
+  SCRIPTS_DIR_SELECTED="${SCRIPT_DIRS[$OR_INPUT]:-$SCRIPT_DIR/scripts}"
+fi
+[[ -d "$SCRIPTS_DIR_SELECTED" ]] || die "Scripts dir '$SCRIPTS_DIR_SELECTED' not found."
+
+# -----------------------------------------------------------------------------
+# Tool paths
+# -----------------------------------------------------------------------------
+declare -A OPENROAD_PATHS=(
+  [ref]="$REPO_ROOT/tools/OpenROAD_ref/build/bin/openroad"
+   # Optional overrides via OPENROAD_ECP / OPENROAD_RWL; default path mirrors ref layout
+  [ecp]="${OPENROAD_ECP:-$REPO_ROOT/tools/OpenROAD_ecp/build/bin/openroad}"
+  [rwl]="${OPENROAD_RWL:-$REPO_ROOT/tools/OpenROAD_rwl/build/bin/openroad}"
+  [pwr]="${OPENROAD_PWR:-$REPO_ROOT/tools/OpenROAD_pwr/build/bin/openroad}"
+)
+
+OPENROAD_EXE="${OPENROAD_PATHS[$OR_INPUT]:-}"
+[[ -n "$OPENROAD_EXE" ]] || die "Unknown OpenROAD selector '$OR_INPUT'. Use ref, ecp, rwl, or pwr."
+[[ -x "$OPENROAD_EXE" ]] || die "OPENROAD_EXE '$OPENROAD_EXE' is not executable."
+
+YOSYS_EXE="$REPO_ROOT/tools/yosys/yosys"
+[[ -x "$YOSYS_EXE" ]] || die "YOSYS_EXE '$YOSYS_EXE' is not executable."
+
+# -----------------------------------------------------------------------------
+# Work directory setup
+# -----------------------------------------------------------------------------
+WORK_SUFFIX="openroad-${OR_INPUT}_config-${FLOW_MODE}"
+NOISE_VALUE="${CLOCK_NOISE_PS:-0}"
+NOISE_TAG="${NOISE_VALUE//./p}"
+WORK_SUFFIX="${WORK_SUFFIX}_noise-${NOISE_TAG}ps"
+FLOW_VARIANT="${WORK_SUFFIX}"
+WORK_HOME_PREFIX="${WORK_HOME_PREFIX:-results}"
+WORK_HOME="${WORK_HOME_PREFIX}_${WORK_SUFFIX}"
+WORK_HOME_PATH="$SCRIPT_DIR/$WORK_HOME"
+mkdir -p "$WORK_HOME_PATH"
+
+# -----------------------------------------------------------------------------
+# Per-step config resolution
+# -----------------------------------------------------------------------------
+resolve_step_config() {
+  local label="$1"
+  local value="$2"
+  if [[ -z "$value" ]]; then
+    echo "$SELECTED_CONFIG"
+    return
+  fi
+  if [[ -f "$value" ]]; then
+    echo "$value"
+    return
+  fi
+  die "Config override for $label '$value' not found."
+}
+
+run_make() {
+  local step="$1"
+  local config="$2"
+  make "${MAKE_VARS[@]}" "DESIGN_CONFIG=$config" "$step" "${MAKE_ARGS[@]}"
+}
+
+# -----------------------------------------------------------------------------
+# Snapshot config + SDC into work configs/
+# -----------------------------------------------------------------------------
+CONFIGS_DIR="$WORK_HOME_PATH/configs/$PLATFORM/$DESIGN/$FLOW_VARIANT"
+mkdir -p "$CONFIGS_DIR"
+COPIED_CONFIG="$CONFIGS_DIR/$(basename "$SELECTED_CONFIG")"
+cp -p "$SELECTED_CONFIG" "$COPIED_CONFIG"
+
+SDC_FILE_RESOLVED="$(
+  make -s --no-print-directory \
+    -f "$SCRIPT_DIR/Makefile" \
+    PLATFORM="$PLATFORM" \
+    DESIGN_CONFIG="$SELECTED_CONFIG" \
+    FLOW_VARIANT="$FLOW_VARIANT" \
+    WORK_HOME="$WORK_HOME_PATH" \
+    SCRIPTS_DIR="$SCRIPTS_DIR_SELECTED" \
+    --eval 'print-sdc: ; @echo $(SDC_FILE)' \
+    print-sdc
+)"
+if [[ -n "$SDC_FILE_RESOLVED" && -f "$SDC_FILE_RESOLVED" ]]; then
+  COPIED_SDC="$CONFIGS_DIR/$(basename "$SDC_FILE_RESOLVED")"
+  cp -p "$SDC_FILE_RESOLVED" "$COPIED_SDC"
+  # Remove any existing SDC_FILE exports before appending our snapshot override.
+  sed -i '/^[[:space:]]*export[[:space:]]\+SDC_FILE[[:space:]]*[:?]*=/d' "$COPIED_CONFIG"
+  {
+    echo ""
+    echo "# Snapshot SDC for this run"
+    echo "export SDC_FILE := $COPIED_SDC"
+  } >> "$COPIED_CONFIG"
+  if [[ -n "$CLOCK_NOISE_PS" ]]; then
+    python3 - "$COPIED_SDC" "$CLOCK_NOISE_PS" <<'PY'
+import re
+import sys
+
+path = sys.argv[1]
+noise_ps = float(sys.argv[2])
+noise_fs = noise_ps * 1.0e3
+
+def parse_time_unit(text):
+    m = re.search(r"set_units\s+-time\s+([0-9]*\.?[0-9]+)?\s*([a-zA-Z]+)", text)
+    if not m:
+        return 1.0e6  # default ns
+    factor = float(m.group(1)) if m.group(1) else 1.0
+    unit = m.group(2).lower()
+    unit_fs = {"fs": 1.0, "ps": 1.0e3, "ns": 1.0e6}.get(unit, 1.0e6)
+    return factor * unit_fs
+
+def fmt_num(value):
+    if abs(value - round(value)) < 1e-12:
+        return str(int(round(value)))
+    s = f"{value:.6f}".rstrip("0").rstrip(".")
+    return s if s else "0"
+
+with open(path, "r", encoding="utf-8") as f:
+    data = f.read()
+
+scale_fs = parse_time_unit(data)
+
+def repl(match):
+    prefix = match.group(1)
+    val = float(match.group(2))
+    new_val = (val * scale_fs + noise_fs) / scale_fs
+    return prefix + fmt_num(new_val)
+
+pattern = re.compile(r"(-period\s+)([0-9]*\.?[0-9]+(?:[eE][-+]?[0-9]+)?)")
+var_period = re.compile(r"-period\s+\$([A-Za-z_][A-Za-z0-9_]*)")
+set_num = re.compile(r"^\s*set\s+([A-Za-z_][A-Za-z0-9_]*)\s+([0-9]*\.?[0-9]+(?:[eE][-+]?[0-9]+)?)\s*$")
+lines = data.splitlines()
+updated = []
+period_vars = set()
+for line in lines:
+    if "create_clock" in line and "-period" in line:
+        line = pattern.sub(repl, line)
+        for m in var_period.finditer(line):
+            period_vars.add(m.group(1))
+    updated.append(line)
+
+if period_vars:
+    adjusted = []
+    for line in updated:
+        m = set_num.match(line)
+        if m and m.group(1) in period_vars:
+            val = float(m.group(2))
+            new_val = (val * scale_fs + noise_fs) / scale_fs
+            line = line.replace(m.group(2), fmt_num(new_val), 1)
+        adjusted.append(line)
+    updated = adjusted
+
+with open(path, "w", encoding="utf-8") as f:
