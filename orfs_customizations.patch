+def parse_sdc_target_clock(path):
+    try:
+        with open(path, 'r') as f:
+            lines = f.readlines()
+    except Exception:
+        return None
+
+    assignments = []
+    create_tokens = []
+    for raw in lines:
+        line = raw.split('#', 1)[0].strip()
+        if not line:
+            continue
+        m = re.match(r'^\s*set\s+([A-Za-z_][A-Za-z0-9_]*)\s+(.+?)\s*$', line)
+        if m:
+            assignments.append((m.group(1), m.group(2)))
+        if 'create_clock' in line and '-period' in line:
+            m = re.search(
+                r'-period\s+(\[[^\]]+\]|\{[^}]+\}|\$[^\s]+|[^\s]+)',
+                line,
+            )
+            if m:
+                create_tokens.append(m.group(1))
+
+    vars_map = {}
+    pending = assignments
+    progress = True
+    while pending and progress:
+        progress = False
+        still = []
+        for var, token in pending:
+            val = resolve_sdc_value(token, vars_map)
+            if val is not None:
+                vars_map[var] = val
+                progress = True
+            else:
+                still.append((var, token))
+        pending = still
+
+    for token in create_tokens:
+        val = resolve_sdc_value(token, vars_map)
+        if val is not None:
+            return val
+    return None
+
