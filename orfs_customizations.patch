+def get_sdc_target_clock(results_dir):
+    search_dirs = []
+    configs_dir = resolve_configs_dir(results_dir)
+    if configs_dir:
+        search_dirs.append(configs_dir)
+    if os.path.isdir(results_dir):
+        search_dirs.append(results_dir)
+
+    for sdc_dir in search_dirs:
+        sdc_files = sorted(glob.glob(os.path.join(sdc_dir, '*.sdc')))
+        for sdc in sdc_files:
+            val = parse_sdc_target_clock(sdc)
+            if val is not None:
+                return val
+    return None
