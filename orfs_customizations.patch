+def resolve_sdc_value(token, vars_map):
+    if token is None:
+        return None
+    token = token.strip().rstrip(';')
+    if token.startswith('{') and token.endswith('}'):
+        token = token[1:-1].strip()
+
+    if token.startswith('[expr') and token.endswith(']'):
+        expr = token[5:-1].strip()
+        expr = expr.strip('{}').strip()
+        unresolved = False
+
+        def repl(m):
+            nonlocal unresolved
+            env_name = m.group(1)
+            brace_name = m.group(2)
+            plain_name = m.group(3)
+            if env_name:
+                env_val = safe_float(os.environ.get(env_name))
+                if env_val is None:
+                    unresolved = True
+                    return ''
+                return str(env_val)
+            var_name = brace_name or plain_name
+            if var_name in vars_map:
+                return str(vars_map[var_name])
+            env_val = safe_float(os.environ.get(var_name))
+            if env_val is None:
+                unresolved = True
+                return ''
+            return str(env_val)
+
+        expr = re.sub(
+            r'\$::env\(([^)]+)\)|\$\{([A-Za-z_][A-Za-z0-9_]*)\}|\$([A-Za-z_][A-Za-z0-9_]*)',
+            repl,
+            expr,
+        )
+        if unresolved:
+            return None
+        return safe_eval_arith(expr)
+
+    if token.startswith('$::env(') and token.endswith(')'):
+        return safe_float(os.environ.get(token[7:-1]))
+    if token.startswith('${') and token.endswith('}'):
+        var_name = token[2:-1]
+        return vars_map.get(var_name, safe_float(os.environ.get(var_name)))
+    if token.startswith('$'):
+        var_name = token[1:]
+        return vars_map.get(var_name, safe_float(os.environ.get(var_name)))
+    return safe_float(token)
+
