diff --git a/flow/batch_run.sh b/flow/batch_run.sh
new file mode 100755
index 000000000..b48dce7d3
--- /dev/null
+++ b/flow/batch_run.sh
@@ -0,0 +1,275 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+FLOW_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+export WORK_HOME_PREFIX="${WORK_HOME_PREFIX:-results}"
+RUN_SH="$FLOW_DIR/run.sh"
+
+log()  { echo "[BATCH] $*" >&2; }
+warn() { echo "[WARN] $*" >&2; }
+die()  { echo "[ERROR] $*" >&2; exit 1; }
+
+print_help() {
+  cat <<'USAGE'
+Usage: batch_run.sh [--openroad NAME ...] (--for-ecp | --for-rwl | --for-pwr)
+
+Runs the predefined batch of designs for each requested OpenROAD build.
+If no selector is provided, the script defaults to: ref, ecp, rwl.
+Optional:
+  --for-ecp  Adds the NG45 table from the doc (ariane133/136, bp_fe_top, swerv_wrapper). Default selectors: ref, ecp (overridable via --openroad).
+  --for-rwl  Runs the RWL batch: high-util combos for asap7/nangate45/sky130hd (see script). Default selectors: ref, rwl (overridable via --openroad).
+  --for-pwr  Runs the PWR batch: aes/ibex/jpeg for asap7/nangate45/sky130hd. Default selectors: ref, pwr (overridable via --openroad).
+  --openroad NAME  One of: ref, ecp, rwl, pwr (repeatable).
+  --design NAME    Run only the specified design (e.g., ariane136).
+  -clock_noise PS  Clock noise in ps (repeatable or comma-separated). If omitted, runs 0, 1, -1, 2, -2.
+
+Environment variables:
+  MAX_PROCS  Limit concurrent jobs (default: 4)
+USAGE
+}
+
+ALLOWED_SELECTORS=("ref" "ecp" "rwl" "pwr")
+ENABLE_FOR_ECP=0
+ENABLE_FOR_RWL=0
+ENABLE_FOR_PWR=0
+CONFIG_FLAG=""
+SELECTORS=()
+CLOCK_NOISE_VALUES=()
+DESIGN_FILTER=""
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    -o|--output|--variant|--openroad)
+      [[ $# -lt 2 ]] && die "$1 requires an argument"
+      SELECTORS+=("$2")
+      shift 2
+      ;;
+    -clock_noise|--clock-noise)
+      [[ $# -lt 2 ]] && die "$1 requires an argument"
+      if [[ "$2" == *","* ]]; then
+        IFS=',' read -ra _noise_parts <<<"$2"
+        CLOCK_NOISE_VALUES+=("${_noise_parts[@]}")
+      else
+        CLOCK_NOISE_VALUES+=("$2")
+      fi
+      shift 2
+      ;;
+    --for-ecp)
+      ENABLE_FOR_ECP=1
+      shift
+      ;;
+    --for-rwl)
+      ENABLE_FOR_RWL=1
+      shift
+      ;;
+    --for-pwr)
+      ENABLE_FOR_PWR=1
+      shift
+      ;;
+    --design)
+      [[ $# -lt 2 ]] && die "$1 requires an argument"
+      DESIGN_FILTER="$2"
+      shift 2
+      ;;
+    -h|--help)
+      print_help
+      exit 0
+      ;;
+    *)
+      if [[ " ${ALLOWED_SELECTORS[*]} " == *" $1 "* ]]; then
+        SELECTORS+=("$1")
+      else
+        die "Unknown argument '$1'. Did you mean -clock_noise?"
+      fi
+      shift
+      ;;
+  esac
+done
+[[ -x "$RUN_SH" ]] || die "run.sh not found or not executable at $RUN_SH"
+
+# Enforce exactly one of --for-ecp / --for-rwl / --for-pwr
+if (( ENABLE_FOR_ECP + ENABLE_FOR_RWL + ENABLE_FOR_PWR > 1 )); then
+  die "--for-ecp, --for-rwl, and --for-pwr are mutually exclusive."
+fi
+if (( ENABLE_FOR_ECP + ENABLE_FOR_RWL + ENABLE_FOR_PWR == 0 )); then
+  die "Either --for-ecp, --for-rwl, or --for-pwr must be specified."
+fi
+
+# Default selectors when none explicitly provided
+if [[ ${#SELECTORS[@]} -eq 0 ]]; then
+  if [[ $ENABLE_FOR_ECP -eq 1 ]]; then
+    SELECTORS=("ref" "ecp")
+  elif [[ $ENABLE_FOR_RWL -eq 1 ]]; then
+    SELECTORS=("ref" "rwl")
+  elif [[ $ENABLE_FOR_PWR -eq 1 ]]; then
+    SELECTORS=("ref" "pwr")
+  fi
+fi
+
+if [[ $ENABLE_FOR_ECP -eq 1 ]]; then
+  CONFIG_FLAG="--config for-ecp"
+elif [[ $ENABLE_FOR_RWL -eq 1 ]]; then
+  CONFIG_FLAG="--config for-rwl"
+elif [[ $ENABLE_FOR_PWR -eq 1 ]]; then
+  CONFIG_FLAG="--config for-pwr"
+fi
+if [[ ${#CLOCK_NOISE_VALUES[@]} -eq 0 ]]; then
+  CLOCK_NOISE_VALUES=(0)
+fi
+
+MAX_PROCS=8
+PIDS=()
+FAILED=0
+
+wait_for_slot() {
+  while [[ ${#PIDS[@]} -ge $MAX_PROCS ]]; do
+    if ! wait -n; then
+      FAILED=1
+    fi
+    local active=()
+    for pid in "${PIDS[@]}"; do
+      if kill -0 "$pid" 2>/dev/null; then
+        active+=("$pid")
+      fi
+    done
+    PIDS=("${active[@]}")
+  done
+}
+
+spawn_task() {
+  local cmd="$1"
+  log "Launching: $cmd"
+  bash -c "cd \"$FLOW_DIR\" && $cmd" &
+  PIDS+=($!)
+  wait_for_slot
+}
+
+wait_for_all() {
+  local status=0
+  for pid in "${PIDS[@]}"; do
+    if ! wait "$pid"; then
+      status=1
+    fi
+  done
+  PIDS=()
+  return $status
+}
+
+add_tasks_for_group() {
+  local platform="$1" designs=(${!2}) noise="$3"
+  for design in "${designs[@]}"; do
+    if [[ -n "$DESIGN_FILTER" && "$design" != "$DESIGN_FILTER" ]]; then
+      continue
+    fi
+    local design_dir="$FLOW_DIR/designs/$platform/$design"
+    if [[ ! -d "$design_dir" ]]; then
+      warn "Skipping missing design directory: $design_dir"
+      continue
+    fi
+    local extra_config=""
+    if [[ "$CONFIG_FLAG" == "--config for-ecp" && "$platform" == "nangate45" && "$design" == "ariane136" && "$OPENROAD_SEL" == "ref" ]]; then
+      extra_config="--config-floorplan $design_dir/config.mk"
+    fi
+    spawn_task "./run.sh -p $platform -d $design -o $OPENROAD_SEL $CONFIG_FLAG $extra_config -clock_noise $noise"
+  done
+}
+
+declare -A DESIGN_SETS
+DESIGN_SETS[group1]="aes ibex jpeg"
+DESIGN_SETS[group_bp_family]="bp_fe_top bp_be_top bp_multi_top black_parrot swerv swerv_wrapper"
+#DESIGN_SETS[group2]="ariane133 ariane136 bp_fe_top swerv_wrapper"
+DESIGN_SETS[group_table_ng45]="ariane133 ariane136 bp_fe_top swerv_wrapper"
+DESIGN_SETS[group_rwl_asap7]="aes ibex jpeg"
+DESIGN_SETS[group_rwl_ng45]="aes ibex jpeg bp_fe_top ariane133 ariane136 swerv_wrapper"
+DESIGN_SETS[group_rwl_sky130hd]="aes ibex jpeg"
+
+# Each entry: "design_group platform [selector_list]"
+# selector_list is optional; when provided it is a comma-separated list of
+# OpenROAD selectors (e.g. ref,ecp) that should run this combo.
+RUN_COMBOS=(
+  "group1 asap7"
+  "group1 sky130hd"
+  "group1 nangate45"
+  "group_bp_family nangate45 ref"
+)
+
+# If --for-ecp is passed, run only the NG45 table
+if [[ $ENABLE_FOR_ECP -eq 1 ]]; then
+  RUN_COMBOS=("group_table_ng45 nangate45 *")
+fi
+# If --for-rwl is passed, run the specified table for rwl
+if [[ $ENABLE_FOR_RWL -eq 1 ]]; then
+  RUN_COMBOS=(
+    "group_rwl_asap7 asap7 *"
+    "group_rwl_ng45 nangate45 *"
+    "group_rwl_sky130hd sky130hd *"
+  )
+fi
+if [[ $ENABLE_FOR_PWR -eq 1 ]]; then
+  RUN_COMBOS=(
+    "group1 asap7 *"
+    "group1 nangate45 *"
+    "group1 sky130hd *"
+  )
+fi
+
+run_for_selector() {
+  OPENROAD_SEL="$1"
+  local noise="$2"
+  local valid=0
+  for allowed in "${ALLOWED_SELECTORS[@]}"; do
+    if [[ "$OPENROAD_SEL" == "$allowed" ]]; then
+      valid=1
+      break
+    fi
+  done
+  if [[ $valid -eq 0 ]]; then
+    warn "Unknown OpenROAD selector '$OPENROAD_SEL'. Use one of: ${ALLOWED_SELECTORS[*]}."
+    FAILED=1
+    return
+  fi
+  log "=== Queuing runs for OpenROAD '$OPENROAD_SEL' (noise ${noise}fs) ==="
+  for combo in "${RUN_COMBOS[@]}"; do
+    read -r group platform selectors <<<"$combo"
+    selectors="${selectors:-*}"
+    if [[ "$selectors" != "*" ]]; then
+      local -a selector_list=()
+      IFS=',' read -ra selector_list <<<"$selectors"
+      local match=0
+      for allowed in "${selector_list[@]}"; do
+        if [[ "$allowed" == "$OPENROAD_SEL" ]]; then
+          match=1
+          break
+        fi
+      done
+      if [[ $match -eq 0 ]]; then
+        continue
+      fi
+    fi
+    designs_str="${DESIGN_SETS[$group]:-}"
+    if [[ -z "$designs_str" ]]; then
+      warn "Unknown design group '$group' in combo '$combo'"
+      continue
+    fi
+    # shellcheck disable=SC2206
+    designs=( $designs_str )
+    add_tasks_for_group "$platform" designs[@] "$noise"
+  done
+}
+
+for noise in "${CLOCK_NOISE_VALUES[@]}"; do
+  for sel in "${SELECTORS[@]}"; do
+    run_for_selector "$sel" "$noise"
+  done
+done
+if ! wait_for_all; then
+  warn "One or more runs failed."
+  FAILED=1
+else
+  log "All queued runs completed."
+fi
+
+if [[ $FAILED -ne 0 ]]; then
+  warn "Some batch runs failed."
+  exit 1
+fi
+log "All requested OpenROAD variants completed."
