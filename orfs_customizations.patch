+
+    # 5. Calculate Effective Clock
+    # Eff = Target - Slack
+    if metrics['Target_Clk'] != 'N/A' and metrics['Slack'] != 'N/A':
+        try:
+            metrics['Eff_Clock'] = float(metrics['Target_Clk']) - float(metrics['Slack'])
+        except ValueError:
+            pass
+
+    # 6. Comparison with 6_finish.rpt derived clock (Legacy Check)
+    finish_rpt = os.path.join(reports_dir, '6_finish.rpt')
+    if os.path.exists(finish_rpt):
+        try:
+            with open(finish_rpt, 'r') as f:
+                content = f.read()
+                # clk period_min = 667.19 fmax = ...
+                p_match = re.search(r'clk period_min\s*=\s*([\d\.]+)', content)
+                
+                if p_match:
+                    # The report explicitly states the min period (effective clock)
+                    metrics['Report_Eff_Clock'] = float(p_match.group(1))
+        except Exception:
+            pass
+
+    # Assertion / Warning
+    if metrics['Eff_Clock'] != 'N/A' and metrics['Report_Eff_Clock'] != 'N/A':
+        diff = abs(metrics['Eff_Clock'] - metrics['Report_Eff_Clock'])
+        # Avoid division by zero
+        if metrics['Eff_Clock'] != 0:
+            pct = diff / abs(metrics['Eff_Clock'])
+            if pct > 0.01:
+                notes.append(
+                    "Eff_Clock Mismatch! "
+                    f"Calc: {metrics['Eff_Clock']}, Rpt: {metrics['Report_Eff_Clock']}"
+                )
+
+    if notes:
+        metrics['Notes'] = "; ".join(notes)
+    
+    apply_unit_conversions(metrics)
+    if metrics.get('Report_Eff_Clock') not in (None, 'N/A'):
+        metrics['Eff_Clock'] = metrics['Report_Eff_Clock']
+
+    if design == 'aes' and platform == 'asap7' and variant == 'base':
+        print(f"DEBUG: {metrics}", file=sys.stderr)
+
+    return metrics
+
+def collect_run_dirs(patterns):
+    run_dirs = []
+    for pattern in patterns:
+        run_dirs.extend(glob.glob(pattern))
+    return [d for d in run_dirs if os.path.isdir(d)]
+
+
+def build_default_patterns():
+    return [
+        'flow/backup_*/logs/*/*/*',
+        'flow/work*/logs/*/*/*',
+        'flow/results*/logs/*/*/*',
+        'flow/logs/*/*/*'
+    ]
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        description=(
+            "Collect OpenROAD flow metrics from run directories and emit a "
+            "Markdown table."
+        )
+    )
+    today = datetime.now().strftime('%Y%m%d_%H%M%S')
+    default_output = os.path.join(
+        os.path.dirname(os.path.abspath(__file__)),
+        f'metrics_{today}.md'
+    )
+    parser.add_argument(
+        '-o',
+        '--output',
+        help=(
+            'Optional path to write the Markdown table '
+            f'(defaults to {default_output}).'
+        )
+    )
+    parser.add_argument(
+        '--pattern',
+        dest='patterns',
+        action='append',
+        help=(
+            'Glob pattern for run directories (repeatable). '
+            'If omitted, built-in defaults cover backup/, work*, and flow/logs.'
+        )
+    )
+    parser.add_argument(
+        '--denoise',
+        action='store_true',
+        help='Also generate denoised_metrics.md for the collected metrics.'
+    )
+    parser.add_argument(
+        '--denoised-output',
+        help='Optional path for denoised_metrics.md when using --denoise.'
+    )
+    args = parser.parse_args()
+
+    search_patterns = args.patterns if args.patterns else build_default_patterns()
+    run_dirs = collect_run_dirs(search_patterns)
+    
+    all_metrics = []
+    for d in run_dirs:
+        m = get_metrics_from_run(d)
+        if m:
+            all_metrics.append(m)
+    
+    all_metrics.sort(key=lambda x: (x['Source'], x['Design'], x['Variant'], x['Platform']))
+    
+    headers = ['Source', 'Design', 'Platform', 'Variant', 'Count', 'Area', 'Power', 'Routed_WL', 'Eff_Clock', 'Target_Clk', 'Slack', 'Notes']
+    widths = {h: len(h) for h in headers}
+    for row in all_metrics:
+        for h in headers:
+            val = str(row.get(h, 'N/A'))
+            widths[h] = max(widths[h], len(val))
+            
+    def format_row(row_data):
+        return "| " + " | ".join(f"{str(row_data.get(h, 'N/A')):<{widths[h]}}" for h in headers) + " |"
+    
+    lines = []
+    lines.append("| " + " | ".join(f"{h:<{widths[h]}}" for h in headers) + " |")
+    lines.append("| " + " | ".join("-" * widths[h] for h in headers) + " |")
+    for row in all_metrics:
+        lines.append(format_row(row))
+
+    output = "\n".join(lines)
+    target = args.output if args.output else default_output
+    with open(target, 'w') as f:
+        f.write(output + "\n")
+    print(f"Wrote metrics for {len(all_metrics)} runs to {target}")
+    if args.denoise:
+        generate_denoised(target, args.denoised_output)
+
+if __name__ == "__main__":
+    main()
