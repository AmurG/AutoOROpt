+#!/usr/bin/env python3
+"""
+Generate Excel comparisons for every variant pair in metrics.md.
+Each sheet corresponds to one (base, target) pair and lists the common
+design/platform rows with baseline, target, and delta metrics.
+"""
+import argparse
+import os
+import re
+import time
+from typing import Dict, Tuple, List
+
+try:
+    import pandas as pd
+except ModuleNotFoundError as exc:
+    raise SystemExit(
+        "pandas is required for this script. Install with 'pip install pandas'."
+    ) from exc
+
+from openpyxl.utils import get_column_letter
+from openpyxl.styles import Alignment
+
+SOURCE_METRICS = [
+    ("Count", "Cell Count"),
+    ("Area", "Area (um^2)"),
+    ("Power", "Power (mW)"),
+    ("Routed_WL", "rWL (um)"),
+    ("Eff_Clock", "ECP (ns)"),
+]
+TARGET_SOURCE_HEADER = "Target_Clk"
+TARGET_HEADER = "TCP (ns)"
+VALID_COUNT_HEADER = "Design Success Count"
+LEGACY_VALID_COUNT_HEADER = "Valid Count"
+TOTAL_NOISE_VARIANTS = 5
+
+
+def parse_table(path: str) -> Tuple[List[str], List[Dict[str, str]]]:
+    """Parse a Markdown table (metrics or denoised_metrics) into dictionaries."""
+    rows: List[Dict[str, str]] = []
+    headers: List[str] = []
+    with open(path, "r") as infile:
+        for raw in infile:
+            raw = raw.strip()
+            if not raw.startswith("|"):
+                continue
+            parts = [col.strip() for col in raw.strip("|").split("|")]
+            if not parts:
+                continue
+            if all(re.match(r"^-+$", part) or part == "" for part in parts):
+                continue
+            if not headers:
+                headers = parts
+                continue
+            if len(parts) != len(headers):
+                continue
+            rows.append(dict(zip(headers, parts)))
+
+    return headers, rows
+
+
+def normalize_denoised(rows: List[Dict[str, str]], summary: str) -> List[Dict[str, str]]:
+    summary_prefix = summary.capitalize()
+    mapped = []
+    for row in rows:
+        normalized = dict(row)
+        normalized["Count"] = row.get(f"{summary_prefix} Count", "N/A")
+        normalized["Area"] = row.get(f"{summary_prefix} Area", "N/A")
+        normalized["Power"] = row.get(f"{summary_prefix} Power", "N/A")
+        normalized["Routed_WL"] = row.get(f"{summary_prefix} Routed_WL", "N/A")
+        normalized["Eff_Clock"] = row.get(f"{summary_prefix} Eff_Clock", "N/A")
+        normalized["Slack"] = row.get(f"{summary_prefix} Slack", "N/A")
+        normalized["Target_Clk"] = row.get("Ave. Target_Clk", "N/A")
+        normalized[VALID_COUNT_HEADER] = row.get(
+            VALID_COUNT_HEADER, row.get(LEGACY_VALID_COUNT_HEADER, "N/A")
+        )
+        mapped.append(normalized)
+    return mapped
+
+
+def build_lookup(rows: List[Dict[str, str]]) -> Dict[str, Dict[Tuple[str, str], Dict[str, str]]]:
+    """Map variant -> {(design, platform): row}."""
+    lookup: Dict[str, Dict[Tuple[str, str], Dict[str, str]]] = {}
+    for row in rows:
+        variant = row.get("Variant")
+        design = row.get("Design")
+        platform = row.get("Platform")
+        if not variant or variant.startswith("-"):
+            continue
+        if not design or not platform:
+            continue
+        lookup.setdefault(variant, {})[(design, platform)] = row
+    return lookup
+
+
+def to_float(value: str) -> float:
+    if value in (None, "", "N/A"):
+        raise ValueError
+    return float(value)
+
+
+def format_value(value: str) -> str:
+    try:
+        num = float(value)
+        if num.is_integer():
+            return f"{int(num)}"
+        formatted = f"{num:.6f}".rstrip("0").rstrip(".")
+        return formatted if formatted else "0"
+    except ValueError:
+        return value
+
+
+def format_percent(delta: float) -> str:
+    return f"{delta:.3f}".rstrip("0").rstrip(".") or "0"
+
+
+def parse_variant_meta(variant: str) -> Tuple[str, str, str]:
+    """
+    Extract util tag, cp tag, and openroad suffix from a variant string.
+    Expected format: util_<util>_cp_<cp>_openroad_<suffix>.
+    """
+    util = "N/A"
+    cp = "N/A"
+    suffix = variant
+    try:
+        if "_openroad_" in variant:
+            head, suffix = variant.split("_openroad_", 1)
+        else:
+            head = variant
+        tokens = head.split("_")
+        if len(tokens) >= 4 and tokens[0] == "util" and tokens[2] == "cp":
+            util = tokens[1]
+            cp = tokens[3]
+    except Exception:
+        pass
+    return util, cp, suffix
+
+
+def parse_openroad_variant(variant: str) -> Tuple[str, str]:
+    """
+    Extract OpenROAD selector and flow mode from a variant.
+    Matches variants like:
+      openroad_ref_for-ecp
+      util_x_cp_y_openroad_rwl_for-rwl
+    """
+    match = re.search(r"(?:^|_)openroad_(ref|ecp|rwl|pwr)_(for-(?:ecp|rwl|pwr))$", variant)
+    if not match:
+        match = re.search(
+            r"openroad-(ref|ecp|rwl|pwr).*?config-for-(ecp|rwl|pwr)",
+            variant,
+        )
+        if not match:
+            return "", ""
+        return match.group(1), f"for-{match.group(2)}"
+    return match.group(1), match.group(2)
+
+
+def variant_label(variant: str) -> str:
+    """
+    Return a short label for a variant: ref/rwl/ecp/pwr if parseable,
+    otherwise return the original string.
+    """
+    selector, _ = parse_openroad_variant(variant)
+    return selector or variant
+
+
+def mode_to_label(mode: str) -> str:
+    """Human-friendly label for flow mode (e.g., 'for rwl')."""
+    return mode.replace("-", " ")
+
+
+def generate_tables(rows: List[Dict[str, str]]):
+    lookup = build_lookup(rows)
+    tables: Dict[Tuple[str, str, str, str, str], pd.DataFrame] = {}
+    expected_target = {
+        "for-ecp": "ecp",
+        "for-rwl": "rwl",
+        "for-pwr": "pwr",
+    }
+    variants = sorted(lookup.keys())
+    groups: Dict[Tuple[str, str, str], Dict[str, str]] = {}
+    for variant in variants:
+        openroad, mode = parse_openroad_variant(variant)
+        if not openroad or not mode:
+            continue
+        util, cp, _ = parse_variant_meta(variant)
+        groups.setdefault((util, cp, mode), {})[openroad] = variant
+
+    for (util_tag, cp_tag, mode), variants_by_or in groups.items():
+        target_or = expected_target.get(mode)
+        if not target_or:
+            continue
+        base = variants_by_or.get("ref")
+        target = variants_by_or.get(target_or)
+        if not base or not target:
+            continue
+        base_entries = lookup.get(base, {})
+        target_entries = lookup.get(target, {})
+        common_keys = sorted(set(base_entries.keys()) & set(target_entries.keys()))
+        if not common_keys:
+            continue
+        records: List[Dict[str, str]] = []
+        for key in common_keys:
+            design, platform = key
+            base_row = base_entries[key]
+            target_row = target_entries[key]
+            def get_success_count(row):
+                return to_float(
+                    row.get(VALID_COUNT_HEADER, row.get(LEGACY_VALID_COUNT_HEADER, "N/A"))
+                )
+
+            def format_failure_count(row):
+                try:
+                    success = get_success_count(row)
+                    failure = TOTAL_NOISE_VARIANTS - success
+                    return format_value(str(failure))
+                except ValueError:
+                    return "N/A"
+
+            record = {
+                "PDK": platform,
+                "Design": design,
+                TARGET_HEADER: format_value(base_row.get(TARGET_SOURCE_HEADER, "N/A")),
+                "Base Design Failure Count": format_failure_count(base_row),
+                "Target Design Failure Count": format_failure_count(target_row),
+            }
+            for source_name, display_name in SOURCE_METRICS:
+                base_val = base_row.get(source_name, "N/A")
+                target_val = target_row.get(source_name, "N/A")
+                base_fmt = format_value(base_val)
+                target_fmt = format_value(target_val)
+                delta_key = f"{display_name} Δ%"
+                try:
+                    base_num = to_float(base_val)
+                    target_num = to_float(target_val)
+                    if base_num == 0:
+                        raise ValueError
+                    delta = (target_num - base_num) / base_num * 100.0
+                    delta_fmt = format_percent(delta)
+                except ValueError:
+                    delta_fmt = "N/A"
+                record[f"Base {display_name}"] = base_fmt
+                record[f"Target {display_name}"] = target_fmt
+                record[delta_key] = delta_fmt
+            records.append(record)
+        df = pd.DataFrame(records)
+        if not df.empty:
+            df = df.sort_values(["PDK", "Design"]).reset_index(drop=True)
+        tables[(util_tag, cp_tag, mode, base, target)] = df
+    return tables
+
+
+def merge_identical_cells(worksheet, df: pd.DataFrame, column_names, start_row=3):
+    for name in column_names:
+        if name not in df.columns:
+            continue
+        values = df[name].tolist()
+        if not values:
+            continue
+        col_idx = df.columns.get_loc(name) + 1  # +1 for Excel column indexing
+        column_letter = get_column_letter(col_idx)
+        row = start_row
+        prev = values[0]
+        run = 1
+        for value in values[1:] + [None]:
+            if value == prev:
+                run += 1
+            else:
+                if run > 1:
+                    worksheet.merge_cells(
+                        f"{column_letter}{row}:{column_letter}{row + run - 1}"
+                    )
+                row += run
+                prev = value
+                run = 1
+
+
+def write_grouped_headers(worksheet, columns, base_label, target_label, start_row=1):
+    top_row = start_row
+    bottom_row = start_row + 1
+    top = []
+    bottom = []
+    for col in columns:
+        if col in {"PDK", "Design", TARGET_HEADER}:
+            top.append(col)
+            bottom.append("")
+        elif col.startswith("Base "):
+            metric = col.replace("Base ", "", 1)
+            top.append(metric)
+            bottom.append(base_label)
+        elif col.startswith("Target "):
+            metric = col.replace("Target ", "", 1)
+            top.append(metric)
+            bottom.append(target_label)
+        elif col.endswith(" Δ%"):
+            metric = col[: -3].strip()
+            top.append(metric)
+            bottom.append("Δ%")
+        else:
+            top.append(col)
+            bottom.append("")
+
+    for idx, value in enumerate(top, start=1):
+        cell = worksheet.cell(row=top_row, column=idx, value=value)
+        cell.alignment = Alignment(horizontal="center", vertical="center")
+    for idx, value in enumerate(bottom, start=1):
+        cell = worksheet.cell(row=bottom_row, column=idx, value=value if value else None)
+        cell.alignment = Alignment(horizontal="center", vertical="center")
+
+    # vertical merges for standalone columns
+    for idx, value in enumerate(bottom, start=1):
+        if not value:
+            worksheet.merge_cells(
+                start_row=top_row, start_column=idx, end_row=bottom_row, end_column=idx
+            )
+
+    # horizontal group merges
+    col = 1
+    while col <= len(top):
+        if bottom[col - 1]:
+            current_metric = top[col - 1]
+            start = col
+            while col <= len(top) and bottom[col - 1] and top[col - 1] == current_metric:
+                col += 1
+            end = col - 1
+            if end > start:
+                worksheet.merge_cells(
+                    start_row=top_row, start_column=start, end_row=top_row, end_column=end
+                )
+            worksheet.cell(row=top_row, column=start).alignment = Alignment(
+                horizontal="center", vertical="center"
+            )
+        else:
+            col += 1
+
+
+def write_banner_row(worksheet, column_count: int, mode_label: str):
+    if column_count <= 0:
+        return
+    banner = mode_label
+    worksheet.merge_cells(start_row=1, start_column=1, end_row=1, end_column=column_count)
+    cell = worksheet.cell(row=1, column=1, value=banner)
+    cell.alignment = Alignment(horizontal="center", vertical="center")
+
+
+def unique_sheet_name(base_name: str, sheet_names: set) -> str:
+    base = base_name[:31]
+    if base not in sheet_names:
+        return base
+    counter = 1
+    while True:
+        suffix = f"_{counter}"
+        trim = 31 - len(suffix)
+        candidate = f"{base_name[:trim]}{suffix}"
+        if candidate not in sheet_names:
+            return candidate
+        counter += 1
+
+
+def center_align_data(worksheet, df: pd.DataFrame, start_row: int):
+    if df.empty:
+        return
+    alignment = Alignment(horizontal="center", vertical="center")
+    max_row = start_row + len(df) - 1
+    max_col = len(df.columns)
+    for row in worksheet.iter_rows(min_row=start_row, max_row=max_row, min_col=1, max_col=max_col):
+        for cell in row:
+            cell.alignment = alignment
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        description="Write Excel sheets comparing every variant pair in metrics.md."
+    )
+    parser.add_argument(
+        "-m",
+        "--metrics",
+        default=None,
+        help=(
+            "Path to metrics Markdown table. "
+            "If omitted, falls back to ./metrics.md, otherwise the most recent metrics_*.md."
+        ),
+    )
+    parser.add_argument(
+        "-o",
+        "--output",
+        default="metrics_comparisons.xlsx",
+        help="Output Excel path (default: metrics_comparisons.xlsx).",
+    )
+    parser.add_argument(
+        "--denoised-summary",
+        choices=("best", "median", "worst"),
+        default="median",
+        help="Summary to use when input is denoised_metrics.md (default: median).",
+    )
+    parser.add_argument(
+        "--all-summaries",
+        action="store_true",
+        help="Generate best/median/worst sheets for denoised_metrics.md.",
+    )
+    parser.add_argument(
+        "--fast",
+        action="store_true",
+        help="Skip cell merges/alignments to speed up Excel generation.",
+    )
+    parser.add_argument(
+        "--timing",
+        action="store_true",
+        help="Print timing for parsing, table generation, and sheet writing.",
+    )
+    args = parser.parse_args()
+
+    metrics_path = args.metrics
+    if metrics_path is None:
+        if os.path.exists("metrics.md"):
+            metrics_path = "metrics.md"
+        else:
+            candidates = [
+                f
+                for f in os.listdir(".")
+                if f.startswith("metrics_") and f.endswith(".md") and os.path.isfile(f)
+            ]
+            metrics_path = max(candidates, key=os.path.getmtime) if candidates else None
+    if metrics_path is None or not os.path.exists(metrics_path):
+        raise SystemExit(
+            "Metrics file not found. Provide one with -m/--metrics (e.g. metrics_20251231_150624.md)."
+        )
+
+    t_start = time.perf_counter()
+    headers, rows = parse_table(metrics_path)
+    t_parse = time.perf_counter()
+    if not rows:
+        raise SystemExit("metrics file seems empty or malformed.")
+
+    denoised_headers = {"Best Count", "Median Count", "Worst Count"}
+    is_denoised = bool(denoised_headers & set(headers))
+
+    summaries = ["median"]
+    if is_denoised:
+        if args.all_summaries:
+            summaries = ["best", "median", "worst"]
+        else:
+            summaries = [args.denoised_summary]
+
+    tables_by_summary = {}
+    for summary in summaries:
+        source_rows = rows
+        if is_denoised:
+            source_rows = normalize_denoised(rows, summary)
+        tables = generate_tables(source_rows)
+        if not tables:
+            raise SystemExit("No variant comparisons generated.")
+        tables_by_summary[summary] = tables
+    t_tables = time.perf_counter()
+    if args.timing:
+        print(f"[timing] parse: {t_parse - t_start:.3f}s", flush=True)
+        print(f"[timing] tables: {t_tables - t_parse:.3f}s", flush=True)
+
+    output_path = os.path.abspath(args.output)
+    sheet_names = set()
+    with pd.ExcelWriter(output_path, engine="openpyxl") as writer:
+        for summary, tables in tables_by_summary.items():
+            summary_tag = summary[:3].upper()
+            for (util_tag, cp_tag, mode, base_suffix, target_suffix), df in tables.items():
+                t_sheet_start = time.perf_counter()
+                if args.timing:
+                    print(f"[timing] start sheet {base_suffix}-{target_suffix}-{summary_tag}", flush=True)
+                base_label = variant_label(base_suffix)
+                target_label = variant_label(target_suffix)
+                base_name = f"{base_suffix}-{target_suffix}-{summary_tag}"
+                sheet_name = unique_sheet_name(base_name, sheet_names)
+                sheet_names.add(sheet_name)
+                df.to_excel(writer, sheet_name=sheet_name, index=False, header=False, startrow=3)
+                ws = writer.sheets[sheet_name]
+                banner = mode_to_label(mode)
+                if is_denoised:
+                    banner = f"{banner} ({summary})"
+                write_banner_row(ws, len(df.columns), banner)
+                write_grouped_headers(ws, df.columns.tolist(), base_label, target_label, start_row=2)
+                if not args.fast:
+                    merge_identical_cells(ws, df, ["PDK", "Design"], start_row=4)
+                    center_align_data(ws, df, start_row=4)
+                if args.timing:
+                    elapsed = time.perf_counter() - t_sheet_start
+                    print(f"[timing] sheet {sheet_name}: {elapsed:.3f}s", flush=True)
+    t_write = time.perf_counter()
+    if args.timing:
+        print(f"[timing] write: {t_write - t_tables:.3f}s", flush=True)
+    total_sheets = sum(len(tables) for tables in tables_by_summary.values())
+    print(f"Wrote {total_sheets} comparison sheets to {output_path}")
+
+
+if __name__ == "__main__":
+    main()
