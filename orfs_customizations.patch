+def extract_ps(variant: str) -> Optional[Tuple[str, int]]:
+    m = re.search(r"(-{1,2}\d+ps)$", variant)
+    if not m:
+        return None
+    raw = m.group(1)
+    if raw.startswith("--"):
+        ps = "-" + raw[2:]
+    else:
+        ps = raw[1:]
+    if ps not in TARGET_PS:
+        return None
+    return ps, m.start(1)
+
+
+def strip_ps_suffix(value: str) -> str:
+    m = re.search(r"(-{1,2}\d+ps)$", value)
+    if not m:
+        return value
+    return value[:m.start(1)].rstrip("-_")
+
