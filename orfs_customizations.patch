+def convert_time_to_ns(value, platform):
+    num = safe_float(value)
+    if num is None:
+        return value
+    factor = TIME_FACTORS_TO_NS.get(platform, 1.0)
+    converted = num * factor
+    return round(converted, 6)
+
+
+def convert_power_to_mw(value):
+    num = safe_float(value)
+    if num is None:
+        return value
+    converted = num * POWER_TO_MW
+    return round(converted, 6)
+
+
+def convert_area_to_um2(value):
+    num = safe_float(value)
+    if num is None:
+        return value
+    return round(num, 6)
+
+
+def convert_time_to_ns_for_tcp(value, platform):
+    try:
+        num = Decimal(str(value))
+    except (InvalidOperation, TypeError, ValueError):
+        return value
+    factor = Decimal(str(TIME_FACTORS_TO_NS.get(platform, 1.0)))
+    converted = num * factor
+    quantized = converted.quantize(Decimal("0.000000001"), rounding=ROUND_HALF_UP)
+    return format(quantized, "f")
+
+
+def apply_unit_conversions(metrics):
+    platform = metrics.get('Platform', '')
+    metrics['Area'] = convert_area_to_um2(metrics.get('Area'))
+    metrics['Power'] = convert_power_to_mw(metrics.get('Power'))
+    metrics['Target_Clk'] = convert_time_to_ns_for_tcp(metrics.get('Target_Clk'), platform)
+    for time_key in ('Slack', 'Eff_Clock', 'Report_Eff_Clock'):
+        metrics[time_key] = convert_time_to_ns(metrics.get(time_key), platform)
