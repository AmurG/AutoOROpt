+def resolve_configs_dir(results_dir):
+    configs_dir = results_dir.replace('/results/', '/configs/')
+    if os.path.isdir(configs_dir):
+        return configs_dir
+
+    # Fallback: resolve configs/<platform>/*/<variant> when design names differ.
+    parts = results_dir.strip(os.sep).split(os.sep)
+    try:
+        idx = parts.index('results')
+        platform = parts[idx + 1]
+        design = parts[idx + 2]
+        variant = parts[idx + 3]
+        base = os.path.join(*parts[:idx])
+        if results_dir.startswith(os.sep):
+            base = os.sep + base
+    except (ValueError, IndexError):
+        return None
+
+    candidates = sorted(
+        glob.glob(os.path.join(base, 'configs', platform, '*', variant))
+    )
+    if not candidates:
+        return None
+    if len(candidates) == 1:
+        return candidates[0]
+
+    # Prefer exact or prefix matches when possible (e.g., bp_fe vs bp_fe_top).
+    exact = [c for c in candidates if os.path.basename(os.path.dirname(c)) == design]
+    if exact:
+        return exact[0]
+    prefix = [
+        c for c in candidates
+        if os.path.basename(os.path.dirname(c)).startswith(design)
+        or design.startswith(os.path.basename(os.path.dirname(c)))
+    ]
+    return prefix[0] if prefix else candidates[0]
