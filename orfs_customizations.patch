+def parse_core_util_from_file(path, flow_root, visited=None):
+    """Return the last CORE_UTILIZATION value found in a config file or its includes."""
+    if visited is None:
+        visited = set()
+    if path in visited:
+        return None
+    visited.add(path)
+
+    pattern = re.compile(r'^\s*export\s+CORE_UTILIZATION\s*(?:\?=|:=|=)\s*([0-9\.]+)')
+    include_pattern = re.compile(r'^\s*include\s+(.+)$')
+    found = None
+    try:
+        with open(path, 'r') as f:
+            for line in f:
+                m = pattern.search(line)
+                if m:
+                    found = m.group(1)
+                    continue
+                m = include_pattern.search(line)
+                if not m:
+                    continue
+                include_targets = m.group(1).split()
+                for target in include_targets:
+                    if "$(" in target or "${" in target:
+                        continue
+                    include_path = target
+                    if not os.path.isabs(include_path):
+                        include_path = os.path.join(flow_root, include_path)
+                    val = parse_core_util_from_file(include_path, flow_root, visited)
+                    if val is not None:
+                        found = str(val)
+    except Exception:
+        return None
+    return float(found) if found is not None else None
+
