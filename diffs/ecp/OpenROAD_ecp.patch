+void TimingBase::loadEnvOverrides()
+{
+  if (auto env_max = getEnvFloat("GPL_WEIGHT_MAX", log_)) {
+    if (*env_max > 0.0F) {
+      net_weight_max_ = *env_max;
+    } else if (log_ != nullptr) {
+      log_->warn(
+          GPL, 125, "Ignoring GPL_WEIGHT_MAX={} (must be > 0).", *env_max);
+    }
+  }
