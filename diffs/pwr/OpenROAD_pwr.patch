+  size_t count = 0;
+  for (const Net* net : nets) {
+    if (net != nullptr) {
+      count += sta_->checkSlewLimits(const_cast<Net*>(net), true, nullptr, max_)
+                   .size();
+    }
+  }
+  return count;
